# Same Postgres/MinIO the rest of Gryzun uses -- see the root .env.example.
PGHOST=localhost
PGPORT=5432
PGDATABASE=gryzun
PGUSER=postgres
PGPASSWORD=

MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=gryzun
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Where Grader/api.py is reachable -- the web app forwards submissions
# there so grading still runs through the existing sandboxed pipeline
# instead of this app needing Docker-socket/Ollama access of its own.
API_BASE_URL=http://localhost:8000

# Any long random string -- signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it stable across restarts, or every logged-in user gets signed out.
NICEGUI_STORAGE_SECRET=
