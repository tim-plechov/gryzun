PGHOST=localhost
PGPORT=5432
PGDATABASE=gryzun
PGUSER=postgres
PGPASSWORD=

# MinIO (S3-compatible object storage), see docker-compose.yml's `minio`
# service -- uploaded task/submission files live here (see db.py). Console
# is at http://localhost:9001, S3 API at http://localhost:9000. The same
# MINIO_ROOT_USER/PASSWORD used to start that container double as its
# access/secret key (set MINIO_ACCESS_KEY/MINIO_SECRET_KEY separately only if
# you've created a dedicated non-root MinIO user).
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=gryzun
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# --- solution-checking API (api.py) -----------------------------------

# Only needed when the API runs inside a container: the real *host*
# filesystem path of ./scratch, an ephemeral directory sandbox.py downloads
# each submission's files into so the host Docker daemon can bind-mount them
# into sandbox containers. Leave unset when running api.py directly on the
# host (it then defaults to SCRATCH_ROOT).
HOST_SCRATCH_ROOT=

# Image built from Dockerfile.sandbox: `docker build -f Dockerfile.sandbox -t gryzun-sandbox:latest .`
SANDBOX_IMAGE=gryzun-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEM_LIMIT=256m
SANDBOX_PIDS_LIMIT=64

# Ollama server -- docker-compose.yml does not run one locally, so point
# this at wherever yours is (local install or remote host).
# Pull the model first: `ollama pull qwen2.5-coder:7b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Optionally use different models for the safety check vs. feedback:
# OLLAMA_SAFETY_MODEL=qwen2.5-coder:7b
# OLLAMA_FEEDBACK_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=60

# --- web app (webapp/) --------------------------------------------------

# Signs the web app's session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it stable across restarts, or every logged-in user gets signed out.
WEBAPP_STORAGE_SECRET=

# Where JupyterHub's per-user Docker volumes live on the host -- assigning a
# task copies its description + sample inputs into
# <this>/jupyterhub-user-<student's jupyter_username>/_data/assigned-tasks/.
# Bind-mounted read-write into the webapp container at this same path (see
# docker-compose.yml). Leave unset to use the default below; only change it
# if your JupyterHub/Docker setup uses a different data-root.
JUPYTER_VOLUMES_ROOT=/data/docker-data/volumes

# Optional: if the Jupyter containers run as a UID that can't read
# root-owned files, set these to have copied files chown'd to it (GID
# defaults to UID if left blank).
JUPYTER_CHOWN_UID=
JUPYTER_CHOWN_GID=
